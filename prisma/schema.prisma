datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id              String   @id @default(uuid())
  name            String
  vinicola        String
  uva             String
  teorAlcoolico   Float
  safra           String
  paisOrigem      String
  regiao          String
  notasDegustacao String
  precoOriginal   Float
  precoPromocional Float?
  status          Boolean  @default(true) // true = ativo, false = inativo
  imagemUrl       String
  estoque         Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Template {
  id          String   @id @default(uuid())
  nome        String
  htmlContent String
  cssStyles   String   // Armazena JSON como String contendo cores, fontes, cabeçalhos e rodapés customizados.
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
