DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# Supabase Connect > API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# The Supabase Auth user with this email is allowed into the admin area.
ADMIN_EMAIL="admin@example.com"
# Keep this for prisma:seed; create the same user in Supabase Auth.
ADMIN_PASSWORD="use-a-strong-password"
# Optional remote browser connection for PDF generation
BROWSERLESS_CONNECT_URL=""
